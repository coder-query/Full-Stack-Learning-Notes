{
  "properties": [
    {
      "name": "encrypt.enabled",
      "type": "java.lang.Boolean",
      "defaultValue": true,
      "description": "是否启用加密功能"
    },
    {
      "name": "encrypt.algorithm",
      "type": "java.lang.String",
      "defaultValue": "SHA-1",
      "description": "加密算法，支持MD5、SHA-1、SHA-256、SHA-512"
    },
    {
      "name": "encrypt.salt-length",
      "type": "java.lang.Integer",
      "defaultValue": 8,
      "description": "盐值长度"
    },
    {
      "name": "encrypt.uppercase",
      "type": "java.lang.Boolean",
      "defaultValue": false,
      "description": "加密结果是否转换为大写"
    }
  ]
}