<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.org.zsh.thymeleafcode.mapper.BookMapper">


    <sql id="Base_Column_List">
        book_id,book_name,author_name,price,category_id,create_time,
        status,book_url,book_address
    </sql>
    <select id="bookPageList" resultType="com.org.zsh.thymeleafcode.model.entity.Book">
        select
            b.*,
            c.category_name as categoryName
        from book as b
        left join category as c on b.category_id = c.category_id
        <where>
            b.status  = 1
        </where>
    </select>
</mapper>
